# Datos (se descargan/generan con src/download_data.py, no se versionan)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv
*.zip

# Excepción: los resultados de los experimentos sí se versionan como evidencia
!results/*.csv
!results/*.json

# Entornos y cachés de Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

# Modelos entrenados (pesan mucho, se regeneran con el código)
models/*.pkl
models/*.joblib
models/*.h5

# Sistema / editor
.DS_Store
.vscode/
.idea/

# App: el random forest pesa ~160 MB (límite de GitHub: 100 MB); se regenera con app/train_export.py
app/artifacts/random_forest.joblib
